{
  "providers": {
    "digitalocean": {
      "type": "digitalocean",
      "base_url": "https://inference.do-ai.run/v1/chat/completions",
      "api_key": "${DO_SERVERLESS_INFERENCE}",
      "models": [
        "llama3.3-70b-instruct",
        "llama3.1-8b-instruct",
        "meta-llama/Llama-3.2-3B-Instruct"
      ]
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${OPENAI_API_KEY}",
      "models": [
        "gpt-oss-120b",
        "gpt-3.5-turbo"
      ]
    },
    "ollama": {
      "type": "ollama",
      "base_url": "http://localhost:11434",
      "models": [
        "moondream",
        "llama3.2",
        "codellama",
        "mistral",
        "phi3:latest",
        "qwen2.5-coder"
      ]
    }
  },
  "default_model": "llama3.3-70b-instruct",
  "default_provider": "digitalocean"
}
