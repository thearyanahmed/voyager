{
  "providers": {
    "digitalocean": {
      "type": "digitalocean",
      "base_url": "https://inference.do-ai.run/v1/chat/completions",
      "api_key": "${DO_SERVERLESS_INFERENCE}",
      "models": [
        "llama3.3-70b-instruct",
        "llama3.1-8b-instruct",
        "meta-llama/Llama-3.2-3B-Instruct"
      ]
    }
  },
  "default_model": "llama3.3-70b-instruct",
  "default_provider": "digitalocean",
  "auto_start_mcps": [
    "digitalocean",
    "filesystem"
  ],
  "mcp_servers": {
    "digitalocean": {
      "name": "digitalocean",
      "command": [
        "npx",
        "-y",
        "@digitalocean/mcp",
        "--services",
        "apps"
      ],
      "env": [
        "DIGITALOCEAN_API_TOKEN=${DIGITALOCEAN_API_TOKEN}"
      ],
      "active": false
    },
    "filesystem": {
      "name": "filesystem",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/paryan/dev/digitalocean/poc/voyager"
      ],
      "env": [],
      "active": false
    }
  }
}
