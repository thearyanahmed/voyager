{
  "providers": {
    "digitalocean": {
      "type": "digitalocean",
      "base_url": "https://inference.do-ai.run/v1/chat/completions",
      "api_key": "${DO_SERVERLESS_INFERENCE}",
      "models": [
        "llama3.3-70b-instruct",
        "llama3.1-8b-instruct",
        "meta-llama/Llama-3.2-3B-Instruct"
      ]
    },
    "openai": {
      "type": "openai",
      "base_url": "https://api.openai.com/v1/chat/completions",
      "api_key": "${OPENAI_API_KEY}",
      "models": [
        "gpt-5",
        "gpt-oss-120b",
        "gpt-4",
        "gpt-4-turbo",
        "gpt-3.5-turbo"
      ]
    }
  },
  "default_model": "llama3.3-70b-instruct",
  "default_provider": "digitalocean",
  "mcp_servers": {
    "digitalocean": {
      "name": "digitalocean",
      "command": [
        "npx",
        "-y",
        "@digitalocean/mcp",
        "--services",
        "apps,databases"
      ],
      "env": [
        "DIGITALOCEAN_API_TOKEN=${DIGITALOCEAN_API_TOKEN}"
      ],
      "active": false
    }
  }
}
